# ==============================================================================
# 1. CONNEXION ADMIN (LECTURE + ÉCRITURE) VIA GOOGLE OAUTH 2.0 (CLIENT-SIDE)
# ==============================================================================
# Client ID OAuth 2.0 Web (Google Cloud Console -> Identifiants -> ID client OAuth 2.0)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=votre-client-id.apps.googleusercontent.com

# ID du classeur Google Sheets d'entraînement
NEXT_PUBLIC_SPREADSHEET_ID=1vCbfHGjbceR-BZUZPLoOG2mkHf4UnFYb2fd65vsYNHE

# ==============================================================================
# 2. ACCÈS LECTURE SEULE PAR EMAIL + MOT DE PASSE (SERVEUR UNIQUEMENT)
# ==============================================================================
# Secret aléatoire (minimum 32 caractères) pour signer les cookies de session HttpOnly
# Générer avec : openssl rand -hex 32
AUTH_SESSION_SECRET=remplacez-par-un-secret-aleatoire-long-de-32-caracteres-minimum

# Liste JSON des utilisateurs autorisés en LECTURE SEULE (générez le hash avec `npm run hash-password -- "motdepasse" "coach@club.fr" "Prénom"`)
AUTH_USERS_JSON=[{"email":"invite@club.fr","name":"Invité","passwordHash":"scrypt$salt$hash"}]

# Compte de service Google (partagez votre Google Sheets en mode "Lecteur" uniquement avec cet email)
GOOGLE_SERVICE_ACCOUNT_EMAIL=pingcoach-reader@votre-projet.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
